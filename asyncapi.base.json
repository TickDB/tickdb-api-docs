    "ticker": {
      "address": "/v1/realtime",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "TickerSubscriptionRequest",
          "title": "Subscribe/Unsubscribe to Real-Time Quotes",
          "summary": "Subscribe or unsubscribe to real-time ticker updates for one or multiple symbols",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "description": "Command type (subscribe or unsubscribe)"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "channel": {
                    "type": "string",
                    "enum": [
                      "ticker",
                      "depth",
                      "trade"
                    ],
                    "default": "ticker",
                    "description": "Channel name"
                  },
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "examples": [
                      "AAPL.US",
                      "700.HK",
                      "EURUSD",
                      "XAUUSD",
                      "BTCUSDT",
                      "IC2606"
                    ],
                    "description": "List of trading symbols to subscribe/unsubscribe"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "indices",
                      "crypto",
                      "forex",
                      "futures"
                    ],
                    "description": "Symbol type, optional. Not required when the symbol is unambiguous; if the server returns an AMBIGUOUS_SYMBOL error, pass the value as indicated"
                  }
                },
                "required": [
                  "channel",
                  "symbols"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerData": {
          "name": "TickerData",
          "title": "Real-Time Quotes Data",
          "summary": "Real-time ticker data pushed from server",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "const": "ticker",
                "description": "Message type"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "AAPL.US",
                    "description": "Trading symbol"
                  },
                  "name": {
                    "type": "string",
                    "description": "Product name, when available"
                  },
                  "type": {
                    "type": "string",
                    "enum": ["stock", "indices", "crypto", "forex", "futures"],
                    "description": "Symbol type"
                  },
                  "category": {
                    "type": "string",
                    "description": "Product category, when available"
                  },
                  "last_price": {
                    "type": "string",
                    "example": "150.25",
                    "description": "Latest price"
                  },
                  "open": {
                    "type": "string",
                    "description": "Opening price, when available"
                  },
                  "prev_close": {
                    "type": "string",
                    "description": "Previous close or reference price, when available"
                  },
                  "bid_price": {
                    "type": "string",
                    "description": "Best bid, when available"
                  },
                  "ask_price": {
                    "type": "string",
                    "description": "Best ask, when available"
                  },
                  "spread": {
                    "type": "string",
                    "description": "Bid-ask spread for forex or metals, when available"
                  },
                  "volume_24h": {
                    "type": "string",
                    "description": "Trading volume; rolling 24 hours for crypto, usually current day or session for stocks and futures"
                  },
                  "quote_volume_24h": {
                    "type": "string",
                    "description": "Turnover over the same window as volume_24h, when available"
                  },
                  "high_24h": {
                    "type": "string",
                    "description": "High price over the same window as volume_24h"
                  },
                  "low_24h": {
                    "type": "string",
                    "description": "Low price over the same window as volume_24h"
                  },
                  "price_change_24h": {
                    "type": "string",
                    "description": "Price change over the same statistics window, when available"
                  },
                  "price_change_percent_24h": {
                    "type": "string",
                    "description": "Price change percentage, when available"
                  },
                  "trade_session": {
                    "type": "string",
                    "enum": ["pre_market", "post_market", "overnight"],
                    "description": "US stock extended trading session, when applicable"
                  },
                  "quote_volume": {
                    "type": "string",
                    "description": "Turnover in the current extended trading session, when available"
                  },
                  "pre_market_quote": {
                    "type": "object",
                    "description": "Pre-market quote, when available"
                  },
                  "post_market_quote": {
                    "type": "object",
                    "description": "Post-market quote, when available"
                  },
                  "overnight_quote": {
                    "type": "object",
                    "description": "Overnight quote, when available"
                  },
                  "timestamp": {
                    "type": "integer",
                    "example": 1703123456789,
                    "description": "Unix timestamp in milliseconds"
                  }
                },
                "required": [
                  "symbol",
                  "last_price",
                  "timestamp"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        }
      }
    },
    "depth": {
      "address": "/v1/realtime",
      "messages": {
        "errorResponse": {
