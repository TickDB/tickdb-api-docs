{
  "asyncapi": "3.0.0",
  "info": {
    "title": "TickDB WebSocket API",
    "version": "1.0.3",
    "description": "Unified real-time market data WebSocket API for Forex, indices, US stocks, HK stocks, A-shares, China futures, and Crypto.",
    "contact": {
      "email": "support@tickdb.ai"
    }
  },
  "servers": {
    "production": {
      "host": "api.tickdb.ai",
      "protocol": "wss",
      "description": "Production WebSocket server",
      "pathname": "/v1/realtime",
      "security": [
        {
          "$ref": "#/components/securitySchemes/apiKey"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "httpApiKey",
        "name": "api_key",
        "in": "query"
      }
    },
    "messages": {
      "errorResponse": {
        "name": "ErrorResponse",
        "title": "WebSocket Error Response",
        "summary": "Subscription or command error returned after the WebSocket connection is established",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cmd": {
              "type": "string",
              "description": "Command that caused the error"
            },
            "code": {
              "description": "Error code; clients should normalize it to a string before comparison",
              "oneOf": [
                { "type": "integer" },
                { "type": "string" }
              ]
            },
            "message": {
              "type": "string",
              "description": "Human-readable error message"
            },
            "data": {
              "description": "Optional error context",
              "oneOf": [
                { "type": "null" },
                { "type": "object", "additionalProperties": true },
                { "type": "array", "items": {} }
              ]
            }
          },
          "required": ["cmd", "code", "message"]
        }
      }
    }
  },
  "channels": {
    "ticker_cn_stock": {
      "address": "/v1/realtime",
      "description": "Full-market A-share ticker subscription; negotiate permessage-deflate during the WebSocket handshake",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "CN_StockFullMarketSubscriptionRequest",
          "title": "Subscribe/Unsubscribe to A-share Full-Market Ticker",
          "summary": "Subscribe or unsubscribe to ticker updates for all A-share symbols; permessage-deflate is required",
          "contentType": "application/json",
          "examples": [
            {
              "name": "subscribe",
              "payload": {
                "cmd": "subscribe",
                "data": {
                  "universes": ["CN_Stock"],
                  "channels": ["ticker"]
                }
              }
            },
            {
              "name": "unsubscribe",
              "payload": {
                "cmd": "unsubscribe",
                "data": {
                  "universes": ["CN_Stock"],
                  "channels": ["ticker"]
                }
              }
            }
          ],
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "default": "subscribe",
                "description": "Command type (subscribe or unsubscribe)"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "universes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "CN_Stock"
                      ]
                    },
                    "default": [
                      "CN_Stock"
                    ],
                    "description": "Full-market universe to subscribe or unsubscribe"
                  },
                  "channels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ticker"
                      ]
                    },
                    "default": [
                      "ticker"
                    ],
                    "description": "Ticker channel for full-market updates"
                  }
                },
                "required": [
                  "universes",
                  "channels"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerBatch": {
          "name": "CN_StockFullMarketTickerBatch",
          "title": "A-share Full-Market Ticker Batch",
          "summary": "Initial snapshot and subsequent ticker updates are sent as arrays of up to 500 messages",
          "contentType": "application/json",
          "payload": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/channels/ticker/messages/tickerData/payload"
            }
          }
        }
      }
    },
