                    },
                    "example": [
                      [
                        "43251.00",
                        "0.180"
                      ],
                      [
                        "43251.50",
                        "0.320"
                      ]
                    ],
                    "description": "卖盘档位，每项为 [价格, 数量]。"
                  },
                  "timestamp": {
                    "type": "integer",
