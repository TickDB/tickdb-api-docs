              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "timestamp": {
                    "type": "integer",
                    "example": 1768976158541,
                    "description": "服务端时间戳，单位为毫秒。"
                  }
                },
                "required": [
                  "timestamp"
                ]
              }
            },
            "required": [
              "cmd",
              "code",
              "message",
              "data"
            ]
          }
        }
      }
    }
