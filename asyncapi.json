    "ticker": {
      "address": "/v1/realtime",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "TickerSubscriptionRequest",
          "title": "订阅或取消订阅实时行情",
          "summary": "订阅或取消订阅一个或多个标的的实时行情。",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "description": "命令类型：订阅或取消订阅。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "channel": {
                    "type": "string",
                    "enum": [
                      "ticker",
                      "depth",
                      "trade"
                    ],
                    "default": "ticker",
                    "description": "频道名称。"
                  },
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "examples": [
                      "AAPL.US",
                      "700.HK",
                      "EURUSD",
                      "XAUUSD",
                      "BTCUSDT",
                      "IC2606"
                    ],
                    "description": "要订阅或取消订阅的交易代码列表。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "indices",
                      "crypto",
                      "forex",
                      "futures"
                    ],
                    "description": "标的类型，可选；代码无歧义时可不传。若返回 AMBIGUOUS_SYMBOL 错误，请根据提示指定类型。"
                  }
                },
                "required": [
                  "channel",
                  "symbols"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerData": {
          "name": "TickerData",
          "title": "实时行情数据",
          "summary": "实时推送的行情数据。",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "const": "ticker",
                "description": "消息类型。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "AAPL.US",
                    "description": "交易代码。"
                  },
                  "name": {
                    "type": "string",
                    "description": "产品名称；有数据时返回。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "indices",
                      "crypto",
                      "forex",
                      "futures"
                    ],
                    "description": "标的类型。"
                  },
                  "category": {
                    "type": "string",
                    "description": "产品细分类别；有数据时返回。"
                  },
                  "last_price": {
                    "type": "string",
                    "example": "150.25",
                    "description": "最新价。"
                  },
                  "open": {
                    "type": "string",
                    "description": "开盘价；有数据时返回。"
                  },
                  "prev_close": {
                    "type": "string",
                    "description": "昨收价或参考价；有数据时返回。"
                  },
                  "bid_price": {
                    "type": "string",
                    "description": "最优买价；有数据时返回。"
                  },
                  "ask_price": {
                    "type": "string",
                    "description": "最优卖价；有数据时返回。"
                  },
                  "spread": {
                    "type": "string",
                    "description": "外汇或贵金属的买卖价差；有数据时返回。"
                  },
                  "volume_24h": {
                    "type": "string",
                    "description": "成交量；加密货币通常为滚动 24 小时，股票和期货通常为当日或当前交易时段。"
                  },
                  "quote_volume_24h": {
                    "type": "string",
                    "description": "与 volume_24h 相同统计窗口内的成交额；有数据时返回。"
                  },
                  "high_24h": {
                    "type": "string",
                    "description": "与 volume_24h 相同统计窗口内的最高价。"
                  },
                  "low_24h": {
                    "type": "string",
                    "description": "与 volume_24h 相同统计窗口内的最低价。"
                  },
                  "price_change_24h": {
                    "type": "string",
                    "description": "相同统计窗口内的价格变化；有数据时返回。"
                  },
                  "price_change_percent_24h": {
                    "type": "string",
                    "description": "价格变化百分比；有数据时返回。"
                  },
                  "trade_session": {
                    "type": "string",
                    "enum": [
                      "pre_market",
                      "post_market",
                      "overnight"
                    ],
                    "description": "美股扩展交易时段；适用时返回。"
                  },
                  "quote_volume": {
                    "type": "string",
                    "description": "当前扩展交易时段的成交额；有数据时返回。"
                  },
                  "pre_market_quote": {
                    "type": "object",
                    "description": "盘前行情；有数据时返回。"
                  },
                  "post_market_quote": {
                    "type": "object",
                    "description": "盘后行情；有数据时返回。"
                  },
                  "overnight_quote": {
                    "type": "object",
                    "description": "夜盘行情；有数据时返回。"
                  },
                  "timestamp": {
                    "type": "integer",
                    "example": 1703123456789,
                    "description": "Unix 时间戳，单位为毫秒。"
                  }
                },
                "required": [
                  "symbol",
                  "last_price",
                  "timestamp"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        }
      }
    },
