{
  "asyncapi": "3.0.0",
  "info": {
    "title": "TickDB WebSocket 接口",
    "version": "1.0.3",
    "description": "统一实时行情 WebSocket 接口，支持外汇、指数、美股、港股、A 股、中国期货和加密货币。",
    "contact": {
      "email": "support@tickdb.ai"
    }
  },
  "servers": {
    "production": {
      "host": "api.tickdb.ai",
      "protocol": "wss",
      "description": "生产环境 WebSocket 服务",
      "pathname": "/v1/realtime",
      "security": [
        {
          "$ref": "#/components/securitySchemes/apiKey"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "httpApiKey",
        "name": "api_key",
        "in": "query"
      }
    },
    "messages": {
      "errorResponse": {
        "name": "ErrorResponse",
        "title": "WebSocket 错误响应",
        "summary": "WebSocket 连接建立后返回的订阅或命令错误。",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cmd": {
              "type": "string",
              "description": "触发错误的命令。"
            },
            "code": {
              "description": "错误码；比较前应统一转为字符串。",
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "message": {
              "type": "string",
              "description": "错误说明。"
            },
            "data": {
              "description": "可选的错误上下文。",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "array",
                  "items": {}
                }
              ]
            }
          },
          "required": [
            "cmd",
            "code",
            "message"
          ]
        }
      }
    }
  },
  "channels": {
    "ticker_cn_stock": {
      "address": "/v1/realtime",
      "description": "A 股全量行情订阅；建立 WebSocket 连接时须协商 permessage-deflate 压缩。",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "CN_StockFullMarketSubscriptionRequest",
          "title": "订阅或取消订阅 A 股全量行情",
          "summary": "订阅或取消订阅全部 A 股标的的行情更新；连接必须启用 permessage-deflate。",
          "contentType": "application/json",
          "examples": [
            {
              "name": "subscribe",
              "payload": {
                "cmd": "subscribe",
                "data": {
                  "universes": [
                    "CN_Stock"
                  ],
                  "channels": [
                    "ticker"
                  ]
                }
              }
            },
            {
              "name": "unsubscribe",
              "payload": {
                "cmd": "unsubscribe",
                "data": {
                  "universes": [
                    "CN_Stock"
                  ],
                  "channels": [
                    "ticker"
                  ]
                }
              }
            }
          ],
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "default": "subscribe",
                "description": "命令类型：订阅或取消订阅。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "universes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "CN_Stock"
                      ]
                    },
                    "default": [
                      "CN_Stock"
                    ],
                    "description": "要订阅或取消订阅的全市场标识。"
                  },
                  "channels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ticker"
                      ]
                    },
                    "default": [
                      "ticker"
                    ],
                    "description": "全量行情固定使用 ticker 频道。"
                  }
                },
                "required": [
                  "universes",
                  "channels"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerBatch": {
          "name": "CN_StockFullMarketTickerBatch",
          "title": "A 股全量行情批次",
          "summary": "初始快照和后续行情更新均以数组分批发送，每批最多 500 条消息。",
          "contentType": "application/json",
          "payload": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/channels/ticker/messages/tickerData/payload"
            }
          }
        }
      }
    },
