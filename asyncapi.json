                        "type": "string",
                        "example": "1252.48",
                        "description": "成交价格。"
                      },
                      "quantity": {
                        "type": "string",
                        "example": "7",
                        "description": "成交数量。"
                      },
                      "side": {
                        "type": "string",
                        "enum": [
                          "buy",
                          "sell",
                          "neutral"
                        ],
                        "example": "sell",
                        "description": "成交方向。"
                      },
                      "timestamp": {
                        "type": "integer",
                        "example": 1789958062000,
