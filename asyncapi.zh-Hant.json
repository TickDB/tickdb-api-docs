    "ticker": {
      "address": "/v1/realtime",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "TickerSubscriptionRequest",
          "title": "訂閱或取消訂閱即時行情",
          "summary": "訂閱或取消訂閱一個或多個標的的即時行情。",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "description": "命令類型：訂閱或取消訂閱。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "channel": {
                    "type": "string",
                    "enum": [
                      "ticker",
                      "depth",
                      "trade"
                    ],
                    "default": "ticker",
                    "description": "頻道名稱。"
                  },
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "examples": [
                      "AAPL.US",
                      "700.HK",
                      "EURUSD",
                      "XAUUSD",
                      "BTCUSDT",
                      "IC2606"
                    ],
                    "description": "要訂閱或取消訂閱的交易代碼列表。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "indices",
                      "crypto",
                      "forex",
                      "futures"
                    ],
                    "description": "標的類型，可選；代碼無歧義時可不傳。若返回 AMBIGUOUS_SYMBOL 錯誤，請依提示指定類型。"
                  }
                },
                "required": [
                  "channel",
                  "symbols"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerData": {
          "name": "TickerData",
          "title": "即時行情數據",
          "summary": "即時推送的行情數據。",
          "contentType": "application/json",
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "const": "ticker",
                "description": "消息類型。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string",
                    "example": "AAPL.US",
                    "description": "交易代碼。"
                  },
                  "name": {
                    "type": "string",
                    "description": "產品名稱；有數據時返回。"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "stock",
                      "indices",
                      "crypto",
                      "forex",
                      "futures"
                    ],
                    "description": "標的類型。"
                  },
                  "category": {
                    "type": "string",
                    "description": "產品細分類別；有數據時返回。"
                  },
                  "last_price": {
                    "type": "string",
                    "example": "150.25",
                    "description": "最新價。"
                  },
                  "open": {
                    "type": "string",
                    "description": "開盤價；有數據時返回。"
                  },
                  "prev_close": {
                    "type": "string",
                    "description": "昨收價或參考價；有數據時返回。"
                  },
                  "bid_price": {
                    "type": "string",
                    "description": "最優買價；有數據時返回。"
                  },
                  "ask_price": {
                    "type": "string",
                    "description": "最優賣價；有數據時返回。"
                  },
                  "spread": {
                    "type": "string",
                    "description": "外匯或貴金屬的買賣價差；有數據時返回。"
                  },
                  "volume_24h": {
                    "type": "string",
                    "description": "成交量；加密貨幣通常為滾動 24 小時，股票和期貨通常為當日或目前交易時段。"
                  },
                  "quote_volume_24h": {
                    "type": "string",
                    "description": "與 volume_24h 相同統計區間內的成交額；有數據時返回。"
                  },
                  "high_24h": {
                    "type": "string",
                    "description": "與 volume_24h 相同統計區間內的最高價。"
                  },
                  "low_24h": {
                    "type": "string",
                    "description": "與 volume_24h 相同統計區間內的最低價。"
                  },
                  "price_change_24h": {
                    "type": "string",
                    "description": "相同統計區間內的價格變化；有數據時返回。"
                  },
                  "price_change_percent_24h": {
                    "type": "string",
                    "description": "價格變化百分比；有數據時返回。"
                  },
                  "trade_session": {
                    "type": "string",
                    "enum": [
                      "pre_market",
                      "post_market",
                      "overnight"
                    ],
                    "description": "美股延長交易時段；適用時返回。"
                  },
                  "quote_volume": {
                    "type": "string",
                    "description": "目前延長交易時段的成交額；有數據時返回。"
                  },
                  "pre_market_quote": {
                    "type": "object",
                    "description": "盤前行情；有數據時返回。"
                  },
                  "post_market_quote": {
                    "type": "object",
                    "description": "盤後行情；有數據時返回。"
                  },
                  "overnight_quote": {
                    "type": "object",
                    "description": "夜盤行情；有數據時返回。"
                  },
                  "timestamp": {
                    "type": "integer",
                    "example": 1703123456789,
                    "description": "Unix 時間戳，單位為毫秒。"
                  }
                },
                "required": [
                  "symbol",
                  "last_price",
                  "timestamp"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        }
      }
    },
