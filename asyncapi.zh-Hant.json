{
  "asyncapi": "3.0.0",
  "info": {
    "title": "TickDB WebSocket 介面",
    "version": "1.0.3",
    "description": "統一即時行情 WebSocket 介面，支援外匯、指數、美股、港股、A 股、中國期貨和加密貨幣。",
    "contact": {
      "email": "support@tickdb.ai"
    }
  },
  "servers": {
    "production": {
      "host": "api.tickdb.ai",
      "protocol": "wss",
      "description": "正式環境 WebSocket 服務",
      "pathname": "/v1/realtime",
      "security": [
        {
          "$ref": "#/components/securitySchemes/apiKey"
        }
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "httpApiKey",
        "name": "api_key",
        "in": "query"
      }
    },
    "messages": {
      "errorResponse": {
        "name": "ErrorResponse",
        "title": "WebSocket 錯誤回應",
        "summary": "WebSocket 連線建立後返回的訂閱或命令錯誤。",
        "contentType": "application/json",
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cmd": {
              "type": "string",
              "description": "觸發錯誤的命令。"
            },
            "code": {
              "description": "錯誤碼；比較前應統一轉為字串。",
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "message": {
              "type": "string",
              "description": "錯誤說明。"
            },
            "data": {
              "description": "可選的錯誤上下文。",
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": true
                },
                {
                  "type": "array",
                  "items": {}
                }
              ]
            }
          },
          "required": [
            "cmd",
            "code",
            "message"
          ]
        }
      }
    }
  },
  "channels": {
    "ticker_cn_stock": {
      "address": "/v1/realtime",
      "description": "A 股全量行情訂閱；建立 WebSocket 連線時須協商 permessage-deflate 壓縮。",
      "messages": {
        "errorResponse": {
          "$ref": "#/components/messages/errorResponse"
        },
        "subscribeRequest": {
          "name": "CN_StockFullMarketSubscriptionRequest",
          "title": "訂閱或取消訂閱 A 股全量行情",
          "summary": "訂閱或取消訂閱全部 A 股標的的行情更新；連線必須啟用 permessage-deflate。",
          "contentType": "application/json",
          "examples": [
            {
              "name": "subscribe",
              "payload": {
                "cmd": "subscribe",
                "data": {
                  "universes": [
                    "CN_Stock"
                  ],
                  "channels": [
                    "ticker"
                  ]
                }
              }
            },
            {
              "name": "unsubscribe",
              "payload": {
                "cmd": "unsubscribe",
                "data": {
                  "universes": [
                    "CN_Stock"
                  ],
                  "channels": [
                    "ticker"
                  ]
                }
              }
            }
          ],
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cmd": {
                "type": "string",
                "enum": [
                  "subscribe",
                  "unsubscribe"
                ],
                "default": "subscribe",
                "description": "命令類型：訂閱或取消訂閱。"
              },
              "data": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "universes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "CN_Stock"
                      ]
                    },
                    "default": [
                      "CN_Stock"
                    ],
                    "description": "要訂閱或取消訂閱的全市場標識。"
                  },
                  "channels": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ticker"
                      ]
                    },
                    "default": [
                      "ticker"
                    ],
                    "description": "全量行情固定使用 ticker 頻道。"
                  }
                },
                "required": [
                  "universes",
                  "channels"
                ]
              }
            },
            "required": [
              "cmd",
              "data"
            ]
          }
        },
        "tickerBatch": {
          "name": "CN_StockFullMarketTickerBatch",
          "title": "A 股全量行情批次",
          "summary": "初始快照和後續行情更新均以陣列分批傳送，每批最多 500 條訊息。",
          "contentType": "application/json",
          "payload": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/channels/ticker/messages/tickerData/payload"
            }
          }
        }
      }
    },
